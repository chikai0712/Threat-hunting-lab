# Create .env with an automatically generated management token:
# python3 scripts/init_env.py
DART_API_TOKEN=
DART_DB_PATH=data/dart.db

# Receiver address; 0.0.0.0 listens on local interfaces, not a device address.
LISTEN_IP=0.0.0.0
HTTP_PORT=8000
SYSLOG_ENABLED=true
SYSLOG_PORT=5514
SOURCE_PUSH_SPOOL=data/source-push.db

# Device/agent sender IPs. Blank disables that source.
# Comma-separated IPs/CIDRs are accepted. Example: 192.0.2.10,192.0.2.11
FORTINET_IPS=
PALOALTO_IPS=
CISCO_IPS=
WINDOWS_IPS=
LINUX_IPS=
AWS_IPS=
KUBERNETES_IPS=

# false: configured sender IPs may push without an API key.
# Management/read APIs always require DART_API_TOKEN.
SOURCE_PUSH_REQUIRE_TOKEN=false
